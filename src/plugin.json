{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "datasource",
  "name": "Мониторинг прибыли маркетплейсов",
  "id": "pumba3000lvl-profitmonitor-datasource",
  "category": "other",
  "metrics": true,
  "backend": true,
  "executable": "gpx_marketplace_profit",
  "alerting": true,
  "info": {
    "description": "Запрашивайте API продавцов Wildberries и Ozon из Grafana. Доступны нормализованные метрики товаров; часть данных о расходах и прибыли пока не предоставляется маркетплейсами.",
    "author": {
      "name": "Pumba3000lvl"
    },
    "keywords": ["marketplace", "wildberries", "ozon", "profit", "datasource"],
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "links": [
      {
        "name": "Документация",
        "url": "https://github.com/Pumba3000lvl/Marketplace-Profit-Monitor#readme"
      },
      {
        "name": "Репозиторий",
        "url": "https://github.com/Pumba3000lvl/Marketplace-Profit-Monitor"
      },
      {
        "name": "Сообщить о проблеме",
        "url": "https://github.com/Pumba3000lvl/Marketplace-Profit-Monitor/issues"
      }
    ],
    "screenshots": [],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "dependencies": {
    "grafanaDependency": ">=11.0.0",
    "plugins": []
  },
  "routes": [
    {
      "path": "wb-tariffs",
      "url": "https://common-api.wildberries.ru",
      "headers": [
        {
          "name": "Authorization",
          "content": "{{ .SecureJsonData.wildberriesToken }}"
        }
      ]
    },
    {
      "path": "wb-prices",
      "url": "https://discounts-prices-api.wildberries.ru",
      "headers": [
        {
          "name": "Authorization",
          "content": "{{ .SecureJsonData.wildberriesToken }}"
        }
      ]
    },
    {
      "path": "ozon",
      "url": "https://api-seller.ozon.ru",
      "headers": [
        {
          "name": "Client-Id",
          "content": "{{ .JsonData.ozonClientId }}"
        },
        {
          "name": "Api-Key",
          "content": "{{ .SecureJsonData.ozonApiKey }}"
        }
      ]
    }
  ]
}
