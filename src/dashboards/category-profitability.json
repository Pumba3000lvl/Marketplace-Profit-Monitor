{
  "id": null,
  "uid": "mpm-category-profitability",
  "title": "Прибыльность по категориям",
  "tags": ["marketplace-profit-monitor", "profitability"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-30d", "to": "now" },
  "timepicker": { "refresh_intervals": ["1m", "5m", "15m", "30m", "1h"], "time_options": ["7d", "30d", "90d"] },
  "templating": {
    "list": [
      {
        "type": "datasource", "name": "datasource", "label": "Источник данных",
        "query": "pumba3000lvl-profitmonitor-datasource", "refresh": 1, "regex": "", "options": [],
        "current": { "selected": true, "text": "Мониторинг прибыли маркетплейсов (оповещения)", "value": "marketplace-profit-monitor" },
        "multi": false, "includeAll": false, "hide": 0
      },
      {
        "type": "custom", "name": "marketplace", "label": "Маркетплейс",
        "query": "wildberries,ozon,both",
        "options": [
          { "selected": false, "text": "Wildberries", "value": "wildberries" },
          { "selected": false, "text": "Ozon", "value": "ozon" },
          { "selected": true, "text": "Оба", "value": "both" }
        ],
        "current": { "selected": true, "text": "Оба", "value": "both" },
        "multi": false, "includeAll": false, "hide": 0
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1, "datasource": { "type": "grafana", "uid": "-- Grafana --" }, "enable": true,
        "hide": true, "iconColor": "rgba(0, 211, 255, 1)", "name": "Annotations & Alerts", "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "barchart",
      "title": "Чистая маржа по категориям (%)",
      "description": "Покажет значения только после появления категорий и рассчитанной чистой маржи в datasource.",
      "datasource": { "type": "pumba3000lvl-profitmonitor-datasource", "uid": "${datasource}" },
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0 },
              { "color": "green", "value": 10 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xField": "name",
        "showValue": "auto",
        "stacking": "none",
        "groupWidth": 0.7,
        "barWidth": 0.97,
        "barRadius": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "pumba3000lvl-profitmonitor-datasource", "uid": "${datasource}" },
          "marketplace": "metrics",
          "selectedMarketplace": "$marketplace",
          "queryType": "profitability",
          "limit": 1000,
          "intervalMs": 60000,
          "maxDataPoints": 43200
        }
      ]
    },
    {
      "id": 2,
      "type": "text",
      "title": "Что нужно для заполнения диаграммы",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 14 },
      "options": {
        "mode": "markdown",
        "content": "### Данные по категориям пока недоступны\n\nТекущий ответ datasource содержит товары и текущие цены, но не содержит категорию товара; чистая маржа также остаётся пустой без всех расходов. Панель использует только реальные поля `name` и `netMarginPercent` и не подменяет категорию товаром. Для заполнения графика нужно добавить к источнику категорию и расчёт маржи."
      },
      "targets": []
    }
  ],
  "links": [],
  "liveNow": false,
  "editable": true,
  "graphTooltip": 0,
  "fiscalYearStartMonth": 0,
  "refresh": "5m"
}
